{
  "name": "magami-ntd",
  "version": "0.1.0",
  "private": true,
  "description": "Magami NTD \u2014 an open, cited map of neglected tropical diseases: pathogens, vectors, treatments, diagnostics, trials, and what is coming.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && npm run build:api && npm run build:llms && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "equity": "tsx scripts/equity-analysis.ts",
    "build:api": "tsx scripts/build-api.ts",
    "build:llms": "tsx scripts/build-llms.ts",
    "fetch:structures": "tsx scripts/fetch-structures.ts",
    "fetch:targets": "tsx scripts/fetch-targets.ts",
    "verify:target": "tsx scripts/verify-target.ts",
    "check:links": "tsx scripts/check-links.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "4.1.13",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "license": "AGPL-3.0-only"
}
